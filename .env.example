# ── Required ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-secret
# Seals Auth Profile secrets (openssl rand -hex 32). Falls back to a key derived from JWT_SECRET.
# Changing it means re-entering every Auth Profile secret.
SECRETS_KEY=
# Optional. true lets tools call private or local addresses (10.x, 192.168.x, localhost).
TOOLS_ALLOW_PRIVATE_NETWORK=false
# Required in production before GitHub can fill demo data. Same value as the Actions secret.
SEED_DEMO_SECRET=
# Optional. Password for qa@acme.com on first create. Defaults to QaDemo1234! when empty.
QA_ACCOUNT_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ybot
POSTGRES_USER=ybot
POSTGRES_PASSWORD=ybotSecret123

# ── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_PASSWORD=valkey123

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ybotadmin
MINIO_ROOT_PASSWORD=ybotSecret123
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ybot-uploads
S3_REGION=us-east-1

# ── LLM — provide at least ONE ───────────────────────────────────────────────
# Chat and website import try them in this order: Gemini, Claude, OpenAI, Groq,
# then Ollama. A later one only runs when the one before it fails.
# LLM_PROVIDER (gemini | claude | ollama | openai | groq) moves one to the front.
LLM_PROVIDER=

# Gemini — free tier, no credit card. Key from https://aistudio.google.com
# gemini-flash-latest always points at the current Flash model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Claude — paid. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama — free, runs on your own machine (no key). Pull the model first:
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Also supported:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Optional global verify token. Each WhatsApp channel also stores its own
# Phone Number ID, access token, and verify token on Connect.
# Webhook URL: https://your-domain.com/api/v1/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=

# SMS, Telegram, phone, and email credentials are entered per channel on
# Channels → Connect. Inbound URLs:
#   /api/v1/webhooks/sms
#   /api/v1/webhooks/telegram
#   /api/v1/webhooks/phone
#   /api/v1/webhooks/email

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
VITE_API_URL=/api/v1

# ── Email (optional — needed for password reset and team invites) ─────────────
# Option A: Resend (https://resend.com — generous free tier, no SMTP setup)
RESEND_API_KEY=
# Option B: SMTP (works with Mailgun, SendGrid, Gmail, your own mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address shown in all transactional emails
EMAIL_FROM=YBot <noreply@yourdomain.com>

# ── Docker volume paths (override for Synology NAS) ──────────────────────────
# PGDATA_PATH=/volume1/docker/ybot/pgdata
# VALKEY_PATH=/volume1/docker/ybot/valkey
# MINIO_PATH=/volume1/docker/ybot/minio

# ── Ports ─────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public"), pg_trgm, unaccent]
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT & ACCOUNT
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  dataRegion String   @default("us")
  plan       String   @default("free")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users          User[]
  memberships    Membership[]
  bots           Bot[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  cannedReplies  CannedReply[]
  dataTables     DataTable[]
  integrations   IntegrationConnection[]
  startTemplates StartTemplate[]
  authProfiles   AuthProfile[]

  @@map("tenants")
}

model StartTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  clusterId  String
  title      String
  body       String
  sourceUrl  String?
  sourceHost String?
  spec       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("start_templates")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  displayName  String
  avatarUrl    String?
  passwordHash String?
  locale       String    @default("en")
  timezone     String    @default("UTC")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  oauthAccounts OAuthAccount[]
  sessions      UserSession[]
  agentProfile  AgentProfile?
  activities    Activity[]

  @@unique([tenantId, email])
  @@map("users")
}

model OAuthAccount {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model UserSession {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     String @default("DEVELOPER")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("memberships")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// BOT & ENVIRONMENT
// ─────────────────────────────────────────────────────────────────────────────

model Bot {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  personaName String?
  description String?
  avatarUrl   String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environments          Environment[]
  flows                 Flow[]
  intents               Intent[]
  entities              Entity[]
  faqs                  Faq[]
  knowledgeSources      KnowledgeSource[]
  channels              Channel[]
  conversations         Conversation[]
  campaigns             Campaign[]
  templates             Template[]
  dashboards            Dashboard[]
  reports               Report[]
  config                BotConfig?
  conversationTemplates ConversationTemplate[]
  templateOptimizations TemplateOptimization[]
  automationRules       AutomationRule[]
  tools                 Tool[]
  guardrailPolicies     GuardrailPolicy[]
  evalSuites            EvalSuite[]
  releases              BotRelease[]

  @@map("bots")
}

model BotConfig {
  id           String   @id @default(cuid())
  tenantId     String
  botId        String   @unique
  model        String   @default("gemini-2.0-flash")
  temperature  Float    @default(0.3)
  maxTokens    Int      @default(2048)
  systemPrompt String   @default("You are a helpful assistant.")
  inboxConfig  Json     @default("{}")
  /// Personal data render modes per reader and custom patterns (see @ybot/shared privacy.ts).
  privacy      Json     @default("{}")
  updatedAt    DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_configs")
}

model Environment {
  id            String   @id @default(cuid())
  tenantId      String
  botId         String
  kind          String   @default("sandbox")
  name          String
  isActive      Boolean  @default(true)
  /// The release guests hear. Null: the working copy (newest saved chart per chapter).
  liveReleaseId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bot           Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  flowVersions  FlowVersion[]
  conversations Conversation[]
  channels      Channel[]

  @@unique([botId, kind])
  @@map("environments")
}

// ─────────────────────────────────────────────────────────────────────────────
// FLOWS
// ─────────────────────────────────────────────────────────────────────────────

model Flow {
  id          String   @id @default(cuid())
  tenantId    String
  botId       String
  name        String
  description String?
  kind        String   @default("flow")
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot      Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  versions FlowVersion[]

  @@map("flows")
}

model FlowVersion {
  id            String    @id @default(cuid())
  tenantId      String
  flowId        String
  environmentId String?
  version       Int
  status        String    @default("draft")
  graph         Json
  variables     Json      @default("[]")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  flow        Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id])
  stepLogs    StepLog[]

  @@unique([flowId, version])
  @@map("flow_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// KNOWLEDGE / TRAINING
// ─────────────────────────────────────────────────────────────────────────────

model Intent {
  id          String   @id @default(cuid())
  tenantId    String
  botId       String
  name        String
  description String?
  utterances  String[]
  responses   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, name])
  @@map("intents")
}

model Entity {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String
  name      String
  kind      String   @default("list")
  values    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, name])
  @@map("entities")
}

model Faq {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String
  question  String
  answer    String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model KnowledgeSource {
  id         String    @id @default(cuid())
  tenantId   String
  botId      String
  name       String
  kind       String
  config     Json      @default("{}")
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bot       Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("knowledge_sources")
}

model Document {
  id                String   @id @default(cuid())
  tenantId          String
  knowledgeSourceId String
  title             String
  content           String
  status            String   @default("processing")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id         String                 @id @default(cuid())
  tenantId   String
  documentId String
  content    String
  embedding  Unsupported("vector")?
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHANNELS
// ─────────────────────────────────────────────────────────────────────────────

model Channel {
  id             String   @id @default(cuid())
  tenantId       String
  botId          String
  environmentId  String
  name           String
  kind           String
  config         Json     @default("{}")
  isActive       Boolean  @default(true)
  allowedDomains String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bot           Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  environment   Environment    @relation(fields: [environmentId], references: [id])
  conversations Conversation[]

  @@map("channels")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONVERSATIONS & INBOX
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id                   String    @id @default(cuid())
  tenantId             String
  botId                String
  environmentId        String
  channelId            String?
  contactId            String?
  status               String    @default("active")
  assignedTo           String?
  teamId               String?
  subject              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  resolvedAt           DateTime?
  firstResponseDueAt   DateTime?
  resolutionDueAt      DateTime?
  firstRespondedAt     DateTime?
  afterHoursNotifiedAt DateTime?
  slaBreachedAt        DateTime?
  /**
   * contained_resolved | contained_partial | contained_unresolved | escalated | abandoned; null while open.
   */
  outcome              String?
  /**
   * The handover contract (reason, priority, tags, summary, variables, routing, context) and how it came back.
   */
  handover             Json?

  bot           Bot                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  environment   Environment         @relation(fields: [environmentId], references: [id])
  channel       Channel?            @relation(fields: [channelId], references: [id])
  contact       Contact?            @relation(fields: [contactId], references: [id])
  messages      Message[]
  tickets       Ticket[]
  stepLogs      StepLog[]
  labels        ConversationLabel[]
  csatResponses CsatResponse[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  direction      String
  authorKind     String   @default("user")
  authorId       String?
  content        Json
  channelMsgId   String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model StepLog {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  flowVersionId  String
  nodeId         String
  nodeKind       String
  input          Json     @default("{}")
  output         Json     @default("{}")
  durationMs     Int      @default(0)
  error          String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flowVersion  FlowVersion  @relation(fields: [flowVersionId], references: [id])

  @@map("step_logs")
}

/**
 * One row per LLM provider call: chat, retrieval, summaries, evals and imports. No foreign keys, so costs outlive deleted chats.
 */
model LlmCall {
  id               String   @id @default(cuid())
  tenantId         String?
  botId            String?
  conversationId   String?
  traceId          String
  /**
   * runtime | retrieval | guardrail | eval | summarisation | authoring
   */
  source           String
  environment      String?
  provider         String
  model            String
  operation        String
  inputTokens      Int      @default(0)
  cachedTokens     Int      @default(0)
  completionTokens Int      @default(0)
  reasoningTokens  Int      @default(0)
  outputTokens     Int      @default(0)
  latencyMs        Int      @default(0)
  ttftMs           Int?
  costUsd          Float?
  ok               Boolean  @default(true)
  error            String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("llm_calls")
}

model Ticket {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String?
  subject        String
  description    String?
  status         String    @default("open")
  priority       String    @default("medium")
  assignedTo     String?
  teamId         String?
  tags           String[]
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Label {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String @default("#94a3b8")

  conversations ConversationLabel[]

  @@unique([tenantId, name])
  @@map("labels")
}

model ConversationLabel {
  conversationId String
  labelId        String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@map("conversation_labels")
}

model AgentProfile {
  id          String  @id @default(cuid())
  tenantId    String
  userId      String  @unique
  displayName String
  status      String  @default("offline")
  teamId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model Team {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  botId    String?

  @@map("teams")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTACTS
// ─────────────────────────────────────────────────────────────────────────────

model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  externalId  String?
  channelId   String?
  displayName String?
  email       String?
  phone       String?
  avatarUrl   String?
  tags        String[] @default([])
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]

  @@map("contacts")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENGAGEMENT: CAMPAIGNS & TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  botId       String
  name        String
  direction   String    @default("outbound")
  channel     String    @default("email")
  status      String    @default("draft")
  subject     String?
  body        String?
  filters     Json      @default("{}") // { hasEmail, hasPhone, channel, tags }
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bot        Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  deliveries CampaignDelivery[]

  @@map("campaigns")
}

model CampaignDelivery {
  id         String    @id @default(cuid())
  tenantId   String
  campaignId String
  contactId  String
  email      String?
  status     String    @default("pending")
  sentAt     DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@map("campaign_deliveries")
}

model Template {
  id             String   @id @default(cuid())
  tenantId       String
  botId          String
  name           String
  channel        String
  approvalStatus String   @default("pending")
  content        Json
  variables      String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, name, channel])
  @@map("templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────────────────────────────────────────

model Dashboard {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String
  name      String
  layout    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot     Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  widgets Widget[]

  @@map("dashboards")
}

model Widget {
  id          String @id @default(cuid())
  tenantId    String
  dashboardId String
  kind        String
  title       String
  config      Json   @default("{}")
  position    Json   @default("{}")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

model Report {
  id        String    @id @default(cuid())
  tenantId  String
  botId     String
  name      String
  query     Json
  schedule  String?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM CONFIG
// ─────────────────────────────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  events    String[]
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  tenantId   String
  webhookId  String
  event      String
  statusCode Int      @default(0)
  success    Boolean  @default(false)
  durationMs Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model CannedReply {
  id        String   @id @default(cuid())
  tenantId  String
  shortcut  String
  title     String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@map("canned_replies")
}

model DataTable {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  columns   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records DataRecord[]

  @@unique([tenantId, name])
  @@map("data_tables")
}

model DataRecord {
  id        String   @id @default(cuid())
  tenantId  String
  tableId   String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table DataTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("data_records")
}

model IntegrationConnection {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String
  apiKey      String?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("integration_connections")
}

model Activity {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String?
  resourceId String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// CSAT & CONVERSATION OPTIMISATION
// ─────────────────────────────────────────────────────────────────────────────

model CsatResponse {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  messageId      String?
  rating         Int // 1 = positive, -1 = negative
  comment        String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("csat_responses")
}

model ConversationTemplate {
  id                   String   @id @default(cuid())
  tenantId             String
  botId                String
  name                 String
  description          String?
  sampleConversationId String?
  clusterKeywords      String[]
  avgQualityScore      Float    @default(0)
  useCount             Int      @default(0)
  status               String   @default("active")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bot           Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  optimizations TemplateOptimization[]

  @@map("conversation_templates")
}

model TemplateOptimization {
  id              String    @id @default(cuid())
  tenantId        String
  botId           String
  templateId      String?
  kind            String // system_prompt | knowledge_boost | flow_hint
  title           String
  description     String
  currentValue    String?
  proposedValue   String
  evidenceCount   Int       @default(1)
  avgQualityScore Float     @default(0)
  status          String    @default("pending") // pending | applied | dismissed
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bot      Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  template ConversationTemplate? @relation(fields: [templateId], references: [id])

  @@map("template_optimizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTOMATION WORKFLOWS
// ─────────────────────────────────────────────────────────────────────────────

model AutomationRule {
  id          String    @id @default(cuid())
  tenantId    String
  botId       String
  name        String
  description String?
  trigger     String // conversation.resolved | message.received | contact.created | ticket.created | schedule | intent_matched | sla.breached
  conditions  String    @default("")
  actions     Json      @default("[]") // array of action strings
  status      String    @default("draft") // active | paused | draft
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// FLOW RUNTIME SESSION
// ─────────────────────────────────────────────────────────────────────────────

model FlowSession {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String   @unique
  botId          String
  flowId         String
  flowVersionId  String
  currentNodeId  String
  variables      Json     @default("{\"flow\":{},\"global\":{},\"contact\":{}}")
  status         String   @default("running") // running | waiting_input | completed | failed | handed_over
  waitingFor     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@map("flow_sessions")
}

/// Credentials for tools. The secret is stored encrypted and never returned by the API.
model AuthProfile {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  /**
   * api_key | bearer | basic | custom_header
   */
  kind       String
  /**
   * Non-secret settings: header name, query parameter name, username.
   */
  settings   Json     @default("{}")
  secretEnc  String?
  secretHint String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tools  Tool[]

  @@unique([tenantId, name])
  @@map("auth_profiles")
}

/// One registry for every tool the bot or a person in the Inbox can run.
model Tool {
  id            String   @id @default(cuid())
  tenantId      String
  botId         String
  name          String
  /**
   * http | function | mcp | knowledge | workflow
   */
  kind          String
  description   String
  parameters    Json     @default("[]")
  returns       Json     @default("{}")
  /**
   * read | write | side_effect
   */
  effect        String   @default("read")
  config        Json     @default("{}")
  authProfileId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bot         Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  authProfile AuthProfile? @relation(fields: [authProfileId], references: [id], onDelete: SetNull)
  runs        ToolRun[]

  @@unique([botId, name])
  @@index([tenantId])
  @@map("tools")
}

model ToolRun {
  id             String   @id @default(cuid())
  tenantId       String
  toolId         String
  conversationId String?
  /**
   * bot | inbox | test
   */
  source         String
  actorId        String?
  ok             Boolean
  status         Int?
  durationMs     Int      @default(0)
  attempts       Int      @default(1)
  input          Json     @default("{}")
  output         Json?
  error          String?
  createdAt      DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, createdAt])
  @@index([conversationId])
  @@map("tool_runs")
}

/// Content guardrails for one bot. At most one policy per bot is active.
model GuardrailPolicy {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String
  name      String
  active    Boolean  @default(false)
  /// GuardrailRule[] (see @ybot/shared guardrails.ts)
  rules     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, active])
  @@map("guardrail_policies")
}

/// Scripted test chats that must pass before a release reaches guests.
model EvalSuite {
  id        String   @id @default(cuid())
  tenantId  String
  botId     String
  name      String
  /// Failing this suite blocks publishing.
  gate      Boolean  @default(true)
  /// EvalScenario[] (see @ybot/shared evals.ts)
  scenarios Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot  Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  runs EvalRun[]

  @@index([botId])
  @@map("eval_suites")
}

model EvalRun {
  id         String   @id @default(cuid())
  tenantId   String
  botId      String
  suiteId    String
  /// manual | publish
  trigger    String   @default("manual")
  /// passed | failed | error
  status     String
  passed     Int      @default(0)
  failed     Int      @default(0)
  /// EvalScenarioResult[]
  results    Json     @default("[]")
  costUsd    Float?
  durationMs Int      @default(0)
  /// What was tested: "working copy" or the release candidate's chapter versions.
  target     Json     @default("{}")
  createdBy  String?
  createdAt  DateTime @default(now())

  suite EvalSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  @@index([suiteId, createdAt])
  @@map("eval_runs")
}

/// A frozen copy of the whole journey. Rows are never updated (a database trigger refuses it).
model BotRelease {
  id            String   @id @default(cuid())
  tenantId      String
  botId         String
  environmentId String
  number        Int
  /// ReleaseChapter[]: flowId, flowVersionId, version, name, tags, graph
  chapters      Json
  entry         String?
  note          String?
  evalRunIds    String[]
  createdBy     String?
  createdAt     DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, environmentId, number])
  @@index([botId, environmentId])
  @@map("bot_releases")
}

# ═══════════════════════════════════════════════════════════════════════════════
# YBot — AVIORI (Synology NAS) production environment
# Copy this file to .env.production and fill in every value marked with <...>
# ═══════════════════════════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=<replace-with-64-char-random-hex>

# ── Database (PostgreSQL 16 + pgvector) ───────────────────────────────────────
POSTGRES_DB=ybot
POSTGRES_USER=ybot
POSTGRES_PASSWORD=<replace-with-strong-password>

# ── In-memory store (Valkey / Redis) ─────────────────────────────────────────
REDIS_PASSWORD=<replace-with-strong-password>

# ── LLM — provide at least ONE ───────────────────────────────────────────────
# Tried in order: Gemini, Claude, then Ollama. A later one only runs when the
# one before it fails. LLM_PROVIDER=ollama puts Ollama first.
# GEMINI_API_KEY=...            # free tier: https://aistudio.google.com
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# LLM_PROVIDER=

# ── Frontend / URLs ───────────────────────────────────────────────────────────
# Set this to the domain or IP users will browse to, e.g.:
#   http://aviori:8080          (LAN hostname, no TLS)
#   https://ybot.yourdomain.com (public domain with Let's Encrypt)
FRONTEND_URL=http://aviori:8080
VITE_API_URL=/api/v1

# ── Docker image tags ─────────────────────────────────────────────────────────
# Set to the GHCR tag you want to deploy, e.g. "sha-abc1234" or "latest"
IMAGE_TAG=latest

# ── Ports ─────────────────────────────────────────────────────────────────────
# Synology DSM occupies port 80/443 by default; use 8080/8443 to avoid conflicts
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Volume paths on the NAS ───────────────────────────────────────────────────
PGDATA_PATH=/volume1/docker/ybot/pgdata
VALKEY_PATH=/volume1/docker/ybot/valkey
